; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ayle"
config/description="AI Agent Office Simulation"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoloads/event_bus.gd"
TimeManager="*res://autoloads/time_manager.gd"
Config="*res://autoloads/config.gd"
SettingsManager="*res://autoloads/settings_manager.gd"
AgentManager="*res://autoloads/agent_manager.gd"
LLMManager="*res://autoloads/llm_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
ConversationManager="*res://scenes/conversations/conversation_manager.gd"
DramaDirector="*res://autoloads/drama_director.gd"
EventManager="*res://scenes/events/event_manager.gd"
ArcManager="*res://scenes/events/arc_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
GroupManager="*res://autoloads/group_manager.gd"
Narrator="*res://autoloads/narrator.gd"
ConfessionalDirector="*res://autoloads/confessional_director.gd"
PlayerDirector="*res://autoloads/player_director.gd"
AudioManager="*res://autoloads/audio_manager.gd"
AchievementManager="*res://autoloads/achievement_manager.gd"
TutorialManager="*res://autoloads/tutorial_manager.gd"
SteamManager="*res://autoloads/steam_manager.gd"
ProducerEconomy="*res://autoloads/producer_economy.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[input]

camera_zoom_in={
"deadzone": 0.5,
"events": []
}
camera_zoom_out={
"deadzone": 0.5,
"events": []
}
camera_pan={
"deadzone": 0.5,
"events": []
}
select={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(143, 17),"global_position":Vector2(147, 58),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
speed_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":46,"key_label":0,"unicode":46,"location":0,"echo":false,"script":null)
